# ==============================================================================
# cPanel FTP Credentials for Automated Deployment
# ==============================================================================
# You can place this file in:
# 1) Global (shared across all projects): C:\Users\Paulimonic\.cpanel.env
# 2) Or local to this project:            c:\Websites\Eclips\.env

CPANEL_FTP_HOST=ftp.paulimonic.com
CPANEL_FTP_USER=paulimon
CPANEL_FTP_PASSWORD=your_cpanel_password_here
CPANEL_FTP_PORT=21
CPANEL_FTP_SECURE=false

# Default remote folder under public_html (e.g. public_html/eclipse)
PROJECT_FOLDER=eclipse
